<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen. Painted with the app's own background colour rather than
     the platform default, so there is no white or black flash before the
     Flutter UI draws its first frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launchBackground" />
</layer-list>
