# Secrets for the `chat` Edge Function.
# Set these with `supabase secrets set KEY=value` — never commit real values.

# DeepSeek API key — get yours at https://platform.deepseek.com
# This is the credential that must NEVER ship inside the mobile app. It lives
# here, server-side, and the function authenticates callers with their own
# Supabase session token instead.
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Browser origins allowed to call this function, comma-separated.
# Leave EMPTY if only the native mobile app calls it: native clients send no
# Origin header and are unaffected, while an empty list denies every browser
# origin. Only add entries if a web build needs access.
# Example: ALLOWED_ORIGINS=https://app.safespend.example,https://safespend.example
ALLOWED_ORIGINS=

# SUPABASE_URL and SUPABASE_ANON_KEY are injected automatically by the Supabase
# runtime and are used to verify the caller's session token. No action needed.
